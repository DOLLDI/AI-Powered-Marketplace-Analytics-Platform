# Copy this file to .env and fill real values.
# Do not commit or send a filled .env to a client.

# Telegram
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_DELIVERY_MODE=webhook
TELEGRAM_WEBHOOK_DEBUG_LOG=false

# VK
VK_GROUP_TOKEN=YOUR_VK_GROUP_TOKEN_HERE
VK_CONFIRMATION_TOKEN=YOUR_VK_CONFIRMATION_TOKEN_HERE
VK_GROUP_ID=
VK_CALLBACK_SECRET=
VK_AUTO_SET_CALLBACK=true
VK_CALLBACK_SERVER_TITLE=ProxyApiBots
VK_LONGPOLL_ENABLED=true
VK_LONGPOLL_WAIT_SECONDS=25

# ProxyAPI / OpenAI-compatible endpoint
PROXYAPI_URL=https://api.proxyapi.ru/openai/v1
PROXYAPI_KEY=
PROXYAPI_TIMEOUT_SECONDS=60

# Runtime safety
APP_ENV=production
REQUIRE_SECURE_CONFIG=false
ADMIN_TOKEN=change-me-admin-token
ADMIN_IDS=123456789,987654321
TELEGRAM_FREE_TESTER_IDS=
BILLING_SECRET=change-me-billing-secret

# Public URLs and webhook setup
APP_BASE_URL=http://localhost:8000
PUBLIC_WEBHOOK_BASE_URL=
AUTO_SET_WEBHOOKS=true
AUTO_SET_TELEGRAM_WEBHOOK=false
START_CLOUDFLARED=false
CLOUDFLARED_METRICS_URL=http://127.0.0.1:4040/metrics
TUNNEL_WAIT_SECONDS=120

# Database: production
DB_BACKEND=postgres
POSTGRES_DB=proxyapi
POSTGRES_USER=proxyapi
POSTGRES_PASSWORD=proxyapi
DATABASE_URL=postgresql://proxyapi:proxyapi@postgres:5432/proxyapi

# Database: local SQLite fallback
SQLITE_DB_PATH=users.db

# Logs
ERROR_LOG_PATH=/app/data/proxyapi_errors.log

# Payments: sandbox, yookassa, robokassa
PAYMENT_PROVIDER=sandbox
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=http://localhost:8000/billing/return
ROBOKASSA_MERCHANT_LOGIN=
ROBOKASSA_PASSWORD1=
ROBOKASSA_PASSWORD2=
ROBOKASSA_PASSWORD3=
ROBOKASSA_TEST_MODE=true

# Optional fiscalization / receipts
MYTAX_API_URL=
MYTAX_API_TOKEN=
MYTAX_SELLER_INN=
FISCAL_RETRY_INTERVAL_SECONDS=300
FISCAL_MAX_ATTEMPTS=5

# Background workers
PAYMENT_SIDE_EFFECT_RETRY_INTERVAL_SECONDS=120
MAINTENANCE_INTERVAL_SECONDS=21600

# Limits and referrals
ANTIFLOOD_WINDOW_SECONDS=10
ANTIFLOOD_MAX_REQUESTS=3
REFERRAL_BONUS_REQUESTS=2

# AI prompts can be placed here or in .env.prompts.
# .env.prompts is loaded after .env and overrides these values.
TELEGRAM_SYSTEM_PROMPT=
VK_SYSTEM_PROMPT=
WB_SUMMARY_PROMPT=

# Wildberries parsing
# WB_MAX_REVIEWS_TOTAL accepts a number or all/все/0/-1.
WB_PROXY_URL=
WB_ENABLE_ROTATING_PROXIES=false
WB_MAX_REVIEWS_TOTAL=10000
WB_BATCH_SIZE=100
WB_MAX_PARSE_SECONDS=45
WB_REQUEST_DELAY_SECONDS=0.35
WB_CACHE_TTL_SECONDS=21600
WB_CACHE_DIR=/app/data/wb_cache
WB_MAX_CONCURRENT_ANALYSES=4

# Price comparison: WB vs Ozon vs Yandex Market
PRICE_COMPARE_ENABLED=true
PRICE_COMPARE_CACHE_TTL_SECONDS=21600
PRICE_COMPARE_TIMEOUT_SECONDS=20
PRICE_COMPARE_HTTP_RETRIES=2
PRICE_COMPARE_BROWSER_FALLBACK_ENABLED=true
PRICE_COMPARE_BROWSER_TIMEOUT_SECONDS=15
PRICE_COMPARE_EXTERNAL_SEARCH_URL=
PRICE_COMPARE_EXTERNAL_SEARCH_KEY=
PRICE_COMPARE_BRAVE_SEARCH_API_KEY=
PRICE_COMPARE_SERPAPI_KEY=
PRICE_COMPARE_SEARCH_ENGINE_FALLBACK_ENABLED=true
PRICE_COMPARE_MAX_RESULTS_PER_MARKETPLACE=3
PRICE_COMPARE_MIN_SIMILARITY=58
PRICE_COMPARE_VISUAL_MATCH_ENABLED=true
PRICE_COMPARE_VISUAL_MAX_CANDIDATES=6
PRICE_COMPARE_VISUAL_TIMEOUT_SECONDS=8
PRICE_COMPARE_METADATA_ENRICHMENT_ENABLED=true
PRICE_COMPARE_METADATA_MAX_CANDIDATES=8
PRICE_COMPARE_METADATA_TIMEOUT_SECONDS=8
PRICE_COMPARE_METADATA_CACHE_TTL_SECONDS=86400
PRICE_COMPARE_METADATA_NEGATIVE_CACHE_TTL_SECONDS=3600
PRICE_COMPARE_SEARCH_RESULTS_LIMIT=12
PRICE_COMPARE_OZON_ENABLED=true
PRICE_COMPARE_YANDEX_ENABLED=true
MARKETPLACE_RISK_MIN_CONFIDENCE=50
MARKETPLACE_RISK_MAX_RECOMMEND=35
MARKETPLACE_RISK_MAX_GAP_TO_WB=8
MARKETPLACE_RISK_HARD_STOP=45
MARKETPLACE_MIN_SAVINGS_PERCENT=8
